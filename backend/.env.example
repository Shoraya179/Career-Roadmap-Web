# ==============================================================
# CareerForge AI Environment Configuration
# ==============================================================
# Server-side environment variable for Google Gemini Generative AI API
# Get your API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Model to use (default: gemini-2.5-flash, also supports gemini-1.5-flash, gemini-2.0-flash)
GEMINI_MODEL=gemini-2.5-flash

# Backend server port
PORT=8000
