# ==============================================================
# CareerForge AI - Server-side Environment Variables
# ==============================================================
# Server-side environment variable for Google Gemini API key
# Keep this secure in your server environment; NEVER expose to client/frontend code.
# Get a key at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: override default model (defaults to gemini-2.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# Backend port
PORT=8000
